{
  "manifest_version": 3,
  "name": "Docs Menu Customizer",
  "description": "Google ドキュメントのツールバー（メニューのバー）の並べ替え・非表示と、ドキュメント専用のダークモード。",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Docs Menu Customizer",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["src/content/main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": [
        "src/shared/settings.js",
        "src/content/core.js",
        "src/content/dark.js",
        "src/content/toolbar.js",
        "src/content/menus.js",
        "src/content/boot.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_start"
    }
  ]
}
